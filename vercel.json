{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
